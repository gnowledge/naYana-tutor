# Local editor / IDE / agent config
.claude/
.vscode/
.idea/
.DS_Store
# Local symlink to AGENTS.md so Claude Code auto-loads project context
CLAUDE.md

# Font build inputs and outputs are regenerable
fonts/source/*.otf
fonts/source/*.ttf
fonts/output/*.otf
fonts/output/*.ttf

# Python build environments
__pycache__/
*.pyc
.venv/
venv/

# Logs
*.log

# Handoff bundles — should never be committed
*.tar.gz
*.patch

# Piper TTS binary + voice model (downloaded via 'make piper')
vendor/

# Working dir for headless-chromium banner renders
/banners/
